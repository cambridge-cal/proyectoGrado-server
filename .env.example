# Copia este archivo como .env y completa los valores. Nunca subas el .env al repositorio (RNF-23).

# Entorno: development | production | test (RNF-28)
NODE_ENV=development
PORT=3000

# Base de datos PostgreSQL (docker compose usa estas mismas variables)
DB_HOST=localhost
DB_PORT=5432
DB_USER=cal
DB_PASSWORD=
DB_NAME=sistema_cal

# Orígenes permitidos por CORS, separados por coma (RNF-09)
CORS_ORIGINS=http://localhost:5173

# Autenticación JWT (RNF-06). Dos secretos distintos de al menos 32 caracteres.
# Para generar cada uno:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_REFRESH_SECRET=

# Contraseña de los usuarios de prueba que crea `npm run semilla` (solo desarrollo)
SEMILLA_CONTRASENA=

# Correo de recuperación de contraseña por SMTP de Gmail, TLS en el puerto 587 (RF-04).
# SMTP_PASS es una "contraseña de aplicación" de Google, no la contraseña normal de la cuenta:
# https://myaccount.google.com/apppasswords (requiere verificación en dos pasos).
# En desarrollo, si SMTP_USER está vacío, el enlace se muestra en la consola del servidor.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Dirección del cliente web, para armar el enlace de restablecimiento
URL_CLIENTE=http://localhost:5173

# Validación semántica con Gemini (TKT-020, RNF-18). Sin clave, los horarios se guardan con validadoGemini = false.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-pro-preview
# Tiempo máximo de espera de la respuesta de Gemini, en milisegundos
GEMINI_TIMEOUT_MS=60000

# Motor de IA: Algoritmo Genético + Búsqueda Tabú (RNF-30). Vacío = valor por defecto de la sección 6.3.1.
MOTOR_POBLACION=50
MOTOR_GENERACIONES=100
MOTOR_TASA_CRUCE=0.8
MOTOR_TASA_MUTACION=0.1
MOTOR_ITERACIONES_TABU=50
MOTOR_TAMANO_TABU=20
MOTOR_VECINOS_TABU=200
MOTOR_MAX_INTENTOS=3
# Semilla opcional para repetir exactamente una generación
MOTOR_SEMILLA=
