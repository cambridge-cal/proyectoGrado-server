# Copia este archivo como .env y completa los valores. Nunca subas el .env al repositorio (RNF-23).

# Entorno: development | production | test (RNF-28)
NODE_ENV=development
PORT=3000

# Base de datos PostgreSQL (docker compose usa estas mismas variables)
DB_HOST=localhost
DB_PORT=5432
DB_USER=cal
DB_PASSWORD=
DB_NAME=sistema_cal

# Orígenes permitidos por CORS, separados por coma (RNF-09)
CORS_ORIGINS=http://localhost:5173

# Autenticación JWT (RNF-06). Dos secretos distintos de al menos 32 caracteres.
# Para generar cada uno:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_REFRESH_SECRET=

# Contraseña de los usuarios de prueba que crea `npm run semilla` (solo desarrollo)
SEMILLA_CONTRASENA=

# Correo de recuperación de contraseña por SMTP de Gmail (TKT-009)
SMTP_USER=
SMTP_PASS=

# Validación semántica con Gemini (TKT-020)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-pro-preview
